# Copy to .env.local and fill in. Never commit real values.

# NextAuth: encrypts the session cookie. Generate with: npx auth secret
AUTH_SECRET=
# Public URL of this app, e.g. https://t-car.example (needed behind a proxy)
AUTH_URL=

# Backend API base URL for requests from the browser, and (optionally) from the server
NEXT_PUBLIC_API_URL=
API_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
