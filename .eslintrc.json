{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "react/no-unescaped-entities": "off",
    "no-console": ["warn", { "allow": ["error"] }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "@/assets/icons/*",
          "@/assets/images/*",
          "@assets/icons/*",
          "@assets/images/*"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "warn",
          { "patterns": ["@/features/*", "@/app/*", "@/services/*"] }
        ]
      }
    },
    {
      "files": ["src/app/**"],
      "rules": {
        "no-restricted-imports": [
          "warn",
          { "patterns": ["@/services/*", "@/features/*/*", "!@/features/*/queries"] }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": ["warn", { "patterns": ["@/app/*"] }]
      }
    },
    {
      "files": ["src/services/**"],
      "rules": {
        "no-restricted-imports": [
          "warn",
          {
            "patterns": [
              "@/features/*/*",
              "!@/features/*/model",
              "@/app/*",
              "@/shared/ui/*",
              "@/shared/hooks/*"
            ]
          }
        ]
      }
    }
  ]
}
